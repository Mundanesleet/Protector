# Flask
FLASK_ENV=development
SECRET_KEY=change-this-in-production

# Base de datos (SQLite por defecto; se deja lista para migrar a PostgreSQL)
DATABASE_URL=sqlite:///prospector.db

# Overpass API (OpenStreetMap) - gratis, sin key
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT=30

# Google Places API (New) - opcional. Sin esto, la busqueda solo usa
# Overpass. Requiere un proyecto de Google Cloud con facturacion activada
# (aunque el uso quede en $0 dentro del nivel gratis). Crear en:
# https://console.cloud.google.com/apis/credentials
# Habilitar "Places API (New)" en el proyecto antes de generar la key.
GOOGLE_MAPS_API_KEY=

# Brave Search API - opcional, para enriquecimiento (Fase de investigacion
# web). $5 gratis/mes automaticos (~1000 busquedas). Crear en:
# https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=
